. * --- 逐个 N 算覆盖率 ---
. tempname cov

. tempfile cs

. postfile `cov' topn avg_cand cov_n cov_v using "Empirical1_data/entry/_cov.dta", repla
> ce
(file Empirical1_data/entry/_cov.dta not found)

. 
. foreach N in 30 50 100 {
  2.     use "Empirical1_data/entry/sim_bi.dta", clear
  3. 
.     gsort main_pid -input_similarity product_id
  4.     by main_pid: gen ri = _n
  5.     gsort main_pid -output_similarity product_id
  6.     by main_pid: gen ro = _n
  7.     keep if ri <= `N' | ro <= `N'
  8.     keep main_pid product_id
  9.     duplicates drop main_pid product_id, force
 10. 
.     bysort main_pid: gen nc = _N
 11.     summarize nc, meanonly
 12.     local avg = r(mean)
 13.     drop nc
 14. 
.     save `cs', replace
 15. 
.     use "Empirical1_data/entry/actual_secondary.dta", clear
 16.     merge m:1 main_pid product_id using `cs', keep(master match)
 17.     gen covered = (_merge == 3)
 18.     drop _merge
 19. 
.     count if covered == 1
 20.     local cn = r(N)
 21.     summarize total_output if covered == 1, meanonly
 22.     local cv = r(sum)
 23. 
.     post `cov' (`N') (`avg') (`cn'/`tot_n'*100) (`cv'/`tot_v'*100)
 24. }
